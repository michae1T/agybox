#!/usr/bin/env bash
# agybox - Run Google Antigravity CLI (agy) with isolated sessions and ~/.gemini state.
# Works on Android (Termux + Fedora proot-distro) and Linux (proot, bwrap, or isolated HOME).

SELF="$0"
CMD="${1:-}"
SUB="${2:-}"

if [ "$CMD" = "--inner" ]; then
cd "$AGYBOX_WS" || exit 1
if [ -f .conv ]; then
CID=$(cat .conv)
exec "$AGY_BIN" --conversation "$CID" --mode auto --settings "$AGYBOX_TRUST"
fi
B0="/tmp/agybox-b0-$$"
B1="/tmp/agybox-b1-$$"
ls -1 "$AGYBOX_BRAIN_SUB" 2>/dev/null | sort > "$B0"
(
while true; do
sleep 2
ls -1 "$AGYBOX_BRAIN_SUB" 2>/dev/null | sort > "$B1"
NEW=$(comm -13 "$B0" "$B1" | head -n 1)
if [ -n "$NEW" ]; then
printf "%s\n" "$NEW" > .conv
break
fi
done
) &
WPID=$!
"$AGY_BIN" --mode auto --settings "$AGYBOX_TRUST"
RC=$?
kill "$WPID" 2>/dev/null
if [ ! -f .conv ]; then
ls -1 "$AGYBOX_BRAIN_SUB" 2>/dev/null | sort > "$B1"
NEW=$(comm -13 "$B0" "$B1" | head -n 1)
if [ -n "$NEW" ]; then
printf "%s\n" "$NEW" > .conv
fi
fi
rm -f "$B0" "$B1"
date +%s > .last
exit "$RC"
fi

case "$CMD" in
-h|--help)
echo "agybox (shortcut: agyb) - Isolated session & brain manager for agy CLI"
echo "Usage:"
echo "  agybox                     List sessions by last used and prompt"
echo "  agybox <name|#>            Start or resume session by name or #"
echo "  agybox manage              Delete, archive, or unarchive a session"
echo "  agybox temp [new|#]        Create or resume a temp session (.tmp/)"
echo "  agybox temp manage         Promote or delete a temp session"
echo "  agybox backup              Back up brain + sessions to Google Drive"
echo "  agybox backup auth         Re-authorize Google Drive in browser"
echo "  agybox backup ignore [id]  Edit global or session .backupignore"
echo "  agybox restore             Restore brain + sessions from Google Drive"
echo "  agybox install             Install agybox and agyb shortcut into PATH"
echo "  agybox --help              Show this help message"
echo "Env vars:"
echo "  AGYBOX_DIR       Base folder (default: ~/Documents/agybox)"
echo "  AGYBOX_SESSIONS  Sessions folder (default: AGYBOX_DIR/sessions)"
echo "  AGYBOX_BRAIN     Isolated ~/.gemini state folder (default: AGYBOX_DIR/state)"
echo "  AGYBOX_MODE      auto | proot-distro | proot | bwrap | home"
echo "  AGYBOX_DRIVE_CLIENT_ID / AGYBOX_DRIVE_CLIENT_SECRET (optional custom OAuth)"
exit 0
;;
esac

is_termux() {
[ -n "${TERMUX_VERSION:-}" ] || [ -d /data/data/com.termux/files/usr ]
}

if [ "$CMD" = "install" ]; then
if is_termux; then
BIN="$PREFIX/bin"
else
BIN="$HOME/.local/bin"
fi
mkdir -p "$BIN"
SRC=$(readlink -f "$SELF" 2>/dev/null || echo "$SELF")
if [ "$SRC" != "$BIN/agybox" ]; then
cp "$SRC" "$BIN/agybox"
fi
chmod +x "$BIN/agybox"
if is_termux && command -v termux-fix-shebang >/dev/null 2>&1; then
termux-fix-shebang "$BIN/agybox"
fi
ln -sf "$BIN/agybox" "$BIN/agyb"
echo "Installed $BIN/agybox and $BIN/agyb"
exit 0
fi

if [ -n "${AGYBOX_DIR:-}" ]; then
BASE_DIR="$AGYBOX_DIR"
elif [ -n "${AGYBOX_SESSIONS:-}" ]; then
BASE_DIR=$(dirname "$AGYBOX_SESSIONS")
elif is_termux && [ -d "$HOME/sessions" ]; then
BASE_DIR="$HOME"
else
DOCS="${XDG_DOCUMENTS_DIR:-$HOME/Documents}"
BASE_DIR="$DOCS/agybox"
fi

SESS_DIR="${AGYBOX_SESSIONS:-$BASE_DIR/sessions}"
if [ -n "${AGYBOX_BRAIN:-}" ]; then
BRAIN_DIR="$AGYBOX_BRAIN"
elif [ "$BASE_DIR" = "$HOME" ] && [ "$SESS_DIR" = "$HOME/sessions" ]; then
BRAIN_DIR="$HOME/sessions/.agy-state"
else
BRAIN_DIR="$BASE_DIR/state"
fi

GSTATE="$BRAIN_DIR/gemini"
mkdir -p "$SESS_DIR" "$GSTATE/antigravity-cli/brain"
mkdir -p "$GSTATE/antigravity-cli/conversations" "$GSTATE/antigravity-cli/knowledge"
mkdir -p "$GSTATE/antigravity-cli/daemon" "$GSTATE/antigravity-cli/persistent_terminals"
mkdir -p "$GSTATE/config/projects"
cd "$SESS_DIR" || exit 1

detect_mode() {
if [ -n "${AGYBOX_MODE:-}" ] && [ "$AGYBOX_MODE" != "auto" ]; then
echo "$AGYBOX_MODE"
return 0
fi
if is_termux; then
echo "proot-distro"
elif command -v proot >/dev/null 2>&1; then
echo "proot"
elif command -v bwrap >/dev/null 2>&1 && bwrap --dev-bind / / true 2>/dev/null; then
echo "bwrap"
else
echo "home"
fi
}

ensure_rclone() {
if ! command -v rclone >/dev/null 2>&1; then
if is_termux; then
echo "Installing rclone..."
pkg install -y rclone || exit 1
else
echo "rclone not found. Install rclone with your package manager."
exit 1
fi
fi
if command -v termux-open-url >/dev/null 2>&1; then
export BROWSER=termux-open-url
fi
}

auth_drive() {
CID="${AGYBOX_DRIVE_CLIENT_ID:-}"
CSEC="${AGYBOX_DRIVE_CLIENT_SECRET:-}"
if [ -z "$CID" ]; then
echo "Note: rclone's shared Google Drive client_id is retiring in 2026."
echo "See: https://rclone.org/drive/#making-your-own-client-id"
read -r -p "Custom OAuth client_id [Enter to skip/keep]: " CID
fi
if [ -n "$CID" ] && [ -z "$CSEC" ]; then
read -r -s -p "Custom OAuth client_secret: " CSEC
echo ""
fi
if rclone listremotes 2>/dev/null | grep -qx 'agy-drive:'; then
if [ -n "$CID" ]; then
rclone config update agy-drive client_id "$CID" client_secret "$CSEC" --non-interactive || return 1
fi
echo "Reconnecting agy-drive in browser..."
rclone config reconnect agy-drive:
else
echo "Opening browser to authorize Google Drive (drive.file scope)..."
if [ -n "$CID" ]; then
rclone config create agy-drive drive scope=drive.file client_id "$CID" client_secret "$CSEC"
else
rclone config create agy-drive drive scope=drive.file
fi
fi
}

ensure_drive() {
ensure_rclone
if ! rclone listremotes 2>/dev/null | grep -qx 'agy-drive:'; then
auth_drive || exit 1
fi
}

rclone_try() {
"$@" && return 0
read -r -p "Drive transfer failed. Re-authorize in browser? [y/N]: " REAUTH
case "$REAUTH" in
y|Y)
auth_drive || return 1
"$@"
;;
*)
return 1
;;
esac
}

init_global_ignore() {
if [ ! -f .backupignore ]; then
cat << 'IGN' > .backupignore
# Global exclusions for agybox backup (rclone --exclude-from)
/.name
/.t
/.ts
/.run-agy.sh
/.sync-agy.sh
/.agy-state/**
/.ex
.venv/**
venv/**
node_modules/**
__pycache__/**
*.pyc
.git/**
target/**
dist/**
build/**
IGN
fi
}

init_session_ignore() {
DIR="$1"
if [ ! -f "$DIR/.backupignore" ]; then
cat << 'SIGN' > "$DIR/.backupignore"
# Per-session exclusions for private Google Drive backup (rclone --exclude-from)
# Add one pattern per line (e.g. folder/**, *.bin, secret.jpg).
.venv/**
venv/**
node_modules/**
__pycache__/**
*.pyc
.git/**
target/**
dist/**
build/**
SIGN
fi
}

init_common_context() {
if [ ! -f GEMINI.md ]; then
cat << 'GMD' > GEMINI.md
# Session Backup Exclusion Policy

Each session directory has a `.backupignore` file (using `rclone --exclude-from` syntax, one pattern per line, such as `folder/**`, `*.bin`, or `secret.jpg`) that controls what is excluded when backing up to the user's private Google Drive.

Whenever you create, download, inspect, or notice files in the current session directory:
1. Keep `.backupignore` in this session directory updated to exclude anything that should NOT be uploaded to Google Drive:
   - Virtual environments, package caches, build artifacts, and dependency folders (`.venv/**`, `node_modules/**`, `__pycache__/**`, `build/**`, etc.).
   - Most binaries, archives, disk images, or large generated artifacts—unless they are small helper scripts or utilities worth keeping.
   - Anything highly sensitive if it ends up in the session directory (such as photos or scans of a passport or ID, bank details, financial documents, private keys, `.env` secrets, or credentials).
2. Use `rclone` patterns relative to the session root (for directories use `dir/**`; for single files use `filename.ext` or `subdir/filename.ext`).
3. If you are in doubt about whether a file or binary should be excluded or backed up, ask the user for confirmation before changing `.backupignore` or assuming it is safe.
GMD
fi
if [ ! -f "$GSTATE/config/GEMINI.md" ] || [ GEMINI.md -nt "$GSTATE/config/GEMINI.md" ]; then
cp GEMINI.md "$GSTATE/config/GEMINI.md"
fi
}

migrate_proot_state() {
[ -f "$GSTATE/.migrated" ] && return 0
cat << 'MIG' > "$SESS_DIR/.sync-agy.sh"
#!/bin/bash
SRC=/root/.gemini
DST=/mnt/agy-gemini
if [ -d "$SRC" ]; then
mkdir -p "$DST"
cp -rn "$SRC/." "$DST/" 2>/dev/null || cp -r "$SRC/." "$DST/" 2>/dev/null || true
fi
find "$DST" -name '*.lock' -delete 2>/dev/null || true
chmod -R u+rwX "$DST" 2>/dev/null || true
touch "$DST/.migrated"
MIG
B1="$SESS_DIR:/root/sessions"
B2="$GSTATE:/mnt/agy-gemini"
proot-distro login fedora --bind "$B1" --bind "$B2" -- /bin/bash /root/sessions/.sync-agy.sh
rm -f "$SESS_DIR/.sync-agy.sh"
}

ensure_termux_proot() {
[ -f "$GSTATE/.fedora-ready" ] && return 0
if ! command -v proot-distro >/dev/null 2>&1; then
echo "First run on Termux: installing proot-distro..."
pkg update -y && pkg install -y proot-distro || exit 1
fi
if ! proot-distro login fedora -- true >/dev/null 2>&1; then
echo "First run on Termux: installing Fedora container..."
proot-distro install fedora || exit 1
fi
if ! proot-distro login fedora -- test -x /root/.local/bin/agy >/dev/null 2>&1; then
echo "First run on Termux: installing curl and agy CLI inside Fedora..."
cat << 'FSET' > "$SESS_DIR/.setup-fedora.sh"
#!/bin/bash
set -e
if [ -f /etc/dnf/dnf.conf ] && ! grep -q 'excludepkgs=.*selinux' /etc/dnf/dnf.conf; then
echo "excludepkgs=*selinux*" >> /etc/dnf/dnf.conf
fi
if ! command -v curl >/dev/null 2>&1; then
dnf install -y curl ca-certificates
fi
curl -fsSL https://antigravity.google/cli/install.sh | bash
test -x /root/.local/bin/agy
FSET
B1="$SESS_DIR:/root/sessions"
proot-distro login fedora --bind "$B1" -- /bin/bash /root/sessions/.setup-fedora.sh
RC=$?
rm -f "$SESS_DIR/.setup-fedora.sh"
[ "$RC" -eq 0 ] || exit 1
fi
touch "$GSTATE/.fedora-ready"
}

sorted_dirs() {
BASE="${1:-.}"
[ -d "$BASE" ] || return 0
(
cd "$BASE" || exit 0
for D in */; do
[ -d "$D" ] || continue
D="${D%/}"
TS=0
if [ -f "$D/.last" ]; then
read -r TS < "$D/.last"
else
stat -c %Y "$D" > .ts 2>/dev/null
read -r TS < .ts
rm -f .ts
fi
TS="${TS:-0}"
printf '%s ' "$TS"
echo "$D"
done | sort -rn | cut -d' ' -f2-
)
}

rand_name() {
R=$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 6)
printf 'tmp-%s\n' "$R"
}

build_excludes() {
init_global_ignore
cat .backupignore > .ex
for BASE in . .tmp .archive; do
[ -d "$BASE" ] || continue
while IFS= read -r D; do
if [ "$BASE" = "." ]; then
P="$D"
else
P="$BASE/$D"
fi
[ -d "$P" ] || continue
init_session_ignore "$P"
while IFS= read -r L; do
L="${L%$'\r'}"
case "$L" in
""|\#*) continue ;;
esac
L="${L#/}"
printf '/%s/' "$P" >> .ex
echo "$L" >> .ex
printf '/%s/**/' "$P" >> .ex
echo "$L" >> .ex
done < "$P/.backupignore"
done < <(sorted_dirs "$BASE")
done
}

if [ "$CMD" = "backup" ]; then
if [ "$SUB" = "ignore" ]; then
init_global_ignore
TARGET=".backupignore"
ARG3="${3:-}"
if [ -n "$ARG3" ]; then
if [ -d "$ARG3" ]; then
init_session_ignore "$ARG3"
TARGET="$ARG3/.backupignore"
elif [ -d ".tmp/$ARG3" ]; then
init_session_ignore ".tmp/$ARG3"
TARGET=".tmp/$ARG3/.backupignore"
else
echo "Session not found: $ARG3"
exit 1
fi
fi
ED="${EDITOR:-}"
if [ -z "$ED" ]; then
if command -v nano >/dev/null 2>&1; then
ED=nano
elif command -v vi >/dev/null 2>&1; then
ED=vi
fi
fi
if [ -n "$ED" ]; then
"$ED" "$TARGET"
else
echo "Edit $PWD/$TARGET"
cat "$TARGET"
fi
exit 0
fi
ensure_drive
if [ "$SUB" = "auth" ]; then
auth_drive || exit 1
exit 0
fi
if is_termux && command -v proot-distro >/dev/null 2>&1; then
if proot-distro login fedora -- true >/dev/null 2>&1; then
migrate_proot_state
fi
fi
CLI_STATE="$GSTATE/antigravity-cli"
for D in brain conversations knowledge; do
if [ -d "$CLI_STATE/$D" ]; then
echo "Backing up $D to agy-drive:agy-backup/$D..."
rclone_try rclone copy "$CLI_STATE/$D" "agy-drive:agy-backup/$D" --exclude '*.lock' -v || exit 1
fi
done
if [ -f "$CLI_STATE/settings.json" ]; then
rclone_try rclone copyto "$CLI_STATE/settings.json" agy-drive:agy-backup/settings.json -v || exit 1
fi
if [ -d "$GSTATE/config" ]; then
rclone_try rclone copy "$GSTATE/config" agy-drive:agy-backup/config -v || exit 1
fi
build_excludes
echo "Backing up sessions to agy-drive:agy-backup/sessions..."
EX=(--exclude-from .ex --exclude-if-present .nobackup)
rclone_try rclone copy . agy-drive:agy-backup/sessions "${EX[@]}" -v
RC=$?
rm -f .ex
[ "$RC" -eq 0 ] || exit 1
echo "Backup complete."
exit 0
fi

if [ "$CMD" = "restore" ]; then
ensure_drive
if is_termux && command -v proot-distro >/dev/null 2>&1; then
if proot-distro login fedora -- true >/dev/null 2>&1; then
migrate_proot_state
fi
fi
CLI_STATE="$GSTATE/antigravity-cli"
echo "Restoring sessions from agy-drive:agy-backup/sessions..."
rclone_try rclone copy agy-drive:agy-backup/sessions . -v || exit 1
echo "Restoring brain and conversation state..."
rclone_try rclone copy agy-drive:agy-backup/brain "$CLI_STATE/brain" -v || exit 1
rclone copy agy-drive:agy-backup/conversations "$CLI_STATE/conversations" -v 2>/dev/null || true
rclone copy agy-drive:agy-backup/knowledge "$CLI_STATE/knowledge" -v 2>/dev/null || true
rclone copy agy-drive:agy-backup/config "$GSTATE/config" -v 2>/dev/null || true
rclone copyto agy-drive:agy-backup/settings.json "$CLI_STATE/settings.json" -v 2>/dev/null || true
echo "Restore complete."
exit 0
fi

if [ "$CMD" = "manage" ]; then
mkdir -p .archive
echo "1) Delete"
echo "2) Archive"
echo "3) Unarchive"
read -r -p "Choose action [1-3]: " ACT
if [ "$ACT" = "1" ]; then
ITEMS=()
PATHS=()
N=0
while IFS= read -r D; do
[ -d "$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
PATHS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .)
while IFS= read -r D; do
[ -d ".archive/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
PATHS+=(".archive/$D")
printf '%s) [archived] ' "$N"
echo "$D"
done < <(sorted_dirs .archive)
if [ "$N" -eq 0 ]; then
echo "No sessions found."
exit 0
fi
read -r -p "Delete #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
TARGET="${PATHS[IDX]}"
NAME="${ITEMS[IDX]}"
if [ -n "$TARGET" ]; then
printf 'Delete %s? [y/N]: ' "$NAME"
read -r ANS
case "$ANS" in
y|Y)
rm -rf "$TARGET"
echo "Deleted."
;;
esac
fi
fi
exit 0
elif [ "$ACT" = "2" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d "$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .)
if [ "$N" -eq 0 ]; then
echo "No active sessions."
exit 0
fi
read -r -p "Archive #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
if [ -e ".archive/$NAME" ]; then
echo "Already archived."
exit 1
fi
mv "$NAME" .archive/
echo "Archived."
fi
fi
exit 0
elif [ "$ACT" = "3" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d ".archive/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .archive)
if [ "$N" -eq 0 ]; then
echo "No archived sessions."
exit 0
fi
read -r -p "Unarchive #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
if [ -e "$NAME" ]; then
echo "Active session with same name exists."
exit 1
fi
mv ".archive/$NAME" .
date +%s > "$NAME/.last"
echo "Unarchived."
fi
fi
exit 0
else
echo "Cancelled."
exit 0
fi
fi

ISTEMP=0
case "$CMD" in
temp|-t) ISTEMP=1 ;;
esac
REL=""
if [ "$ISTEMP" -eq 1 ]; then
mkdir -p .tmp
if [ "$SUB" = "manage" ]; then
echo "1) Promote to primary"
echo "2) Delete"
read -r -p "Choose action [1-2]: " ACT
if [ "$ACT" = "1" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d ".tmp/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .tmp)
if [ "$N" -eq 0 ]; then
echo "No temp sessions."
exit 0
fi
read -r -p "Promote #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
printf 'Primary name [%s]: ' "$NAME"
read -r NEWNAME
if [ -z "$NEWNAME" ]; then
NEWNAME="$NAME"
fi
NEWNAME="${NEWNAME// /-}"
NEWNAME="${NEWNAME//\//-}"
if [ -e "$NEWNAME" ]; then
echo "Session with that name already exists."
exit 1
fi
mv ".tmp/$NAME" .tmp-mv
mv .tmp-mv "$NEWNAME"
date +%s > "$NEWNAME/.last"
echo "Promoted."
fi
fi
exit 0
elif [ "$ACT" = "2" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d ".tmp/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .tmp)
if [ "$N" -eq 0 ]; then
echo "No temp sessions."
exit 0
fi
read -r -p "Delete #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
printf 'Delete temp %s? [y/N]: ' "$NAME"
read -r ANS
case "$ANS" in
y|Y)
rm -rf ".tmp/$NAME"
echo "Deleted."
;;
esac
fi
fi
exit 0
else
echo "Cancelled."
exit 0
fi
fi

LIST=()
N=0
while IFS= read -r D; do
[ -d ".tmp/$D" ] || continue
N=$((N + 1))
LIST+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .tmp)

PICK="$SUB"
if [ -z "$PICK" ]; then
read -r -p "Temp # or name [new random]: " PICK
fi
case "$PICK" in
""|new)
SESSION=$(rand_name)
;;
*)
if [ "$PICK" -gt 0 ] 2>/dev/null; then
IDX=$((PICK - 1))
FOUND="${LIST[IDX]}"
if [ -n "$FOUND" ]; then
SESSION="$FOUND"
else
SESSION="$PICK"
fi
else
SESSION="$PICK"
fi
;;
esac
SESSION="${SESSION// /-}"
SESSION="${SESSION//\//-}"
REL=".tmp/$SESSION"
else
LIST=()
N=0
while IFS= read -r D; do
[ -d "$D" ] || continue
N=$((N + 1))
LIST+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .)

SESSION="$CMD"
if [ -z "$SESSION" ]; then
read -r -p "Session name or # [default]: " SESSION
fi
SESSION="${SESSION:-default}"
if [ "$SESSION" -gt 0 ] 2>/dev/null; then
IDX=$((SESSION - 1))
PICK="${LIST[IDX]}"
if [ -n "$PICK" ]; then
SESSION="$PICK"
fi
fi
SESSION="${SESSION// /-}"
SESSION="${SESSION//\//-}"
REL="$SESSION"
fi

mkdir -p "$REL"
init_session_ignore "$REL"
init_common_context
date +%s > "$REL/.last"
MODE=$(detect_mode)

if [ "$MODE" = "proot-distro" ]; then
ensure_termux_proot
migrate_proot_state
printf '%s\n' "$REL" > .name
W="/root/sessions/$REL"
echo "{\"trustedWorkspaces\":[\"$W\"]}" > .t

printf '%s\n' '#!/bin/bash
[ -f /etc/profile ] && . /etc/profile
if [ -f /root/.bash_profile ]; then
. /root/.bash_profile
fi
[ -f /root/.bashrc ] && . /root/.bashrc
export PATH="/root/.local/bin:$PATH"
S=$(cat /root/sessions/.name)
cd "/root/sessions/$S" || exit 1
BRAIN=/root/.gemini/antigravity-cli/brain
mkdir -p "$BRAIN"
if [ -f .conv ]; then
CID=$(cat .conv)
/root/.local/bin/agy --conversation "$CID" --mode auto --settings /root/sessions/.t
else
ls -1 "$BRAIN" 2>/dev/null | sort > /tmp/b0
(
while true; do
sleep 2
ls -1 "$BRAIN" 2>/dev/null | sort > /tmp/b1
NEW=$(comm -13 /tmp/b0 /tmp/b1 | head -n 1)
if [ -n "$NEW" ]; then
printf "%s\n" "$NEW" > .conv
break
fi
done
) &
WPID=$!
/root/.local/bin/agy --mode auto --settings /root/sessions/.t
kill "$WPID" 2>/dev/null
if [ ! -f .conv ]; then
ls -1 "$BRAIN" 2>/dev/null | sort > /tmp/b1
NEW=$(comm -13 /tmp/b0 /tmp/b1 | head -n 1)
if [ -n "$NEW" ]; then
printf "%s\n" "$NEW" > .conv
fi
fi
fi
date +%s > .last' > .run-agy.sh

B1="$SESS_DIR:/root/sessions"
B2="$GSTATE:/root/.gemini"
A=(login fedora)
A+=(--bind "$B1" --bind "$B2")
A+=(-- /bin/bash /root/sessions/.run-agy.sh)
exec proot-distro "${A[@]}"
fi

AGY_BIN=$(command -v agy 2>/dev/null || true)
if [ -z "$AGY_BIN" ] && [ -x "$HOME/.local/bin/agy" ]; then
AGY_BIN="$HOME/.local/bin/agy"
fi
if [ -z "$AGY_BIN" ]; then
echo "agy not found in PATH or $HOME/.local/bin/agy"
exit 1
fi

SELF_ABS=$(readlink -f "$SELF" 2>/dev/null || echo "$SELF")
TRUST_FILE="$SESS_DIR/.t"
TARGET_WS="$SESS_DIR/$REL"
echo "{\"trustedWorkspaces\":[\"$TARGET_WS\"]}" > "$TRUST_FILE"
export AGY_BIN
export AGYBOX_WS="$TARGET_WS"
export AGYBOX_TRUST="$TRUST_FILE"
export AGYBOX_BRAIN_SUB="$GSTATE/antigravity-cli/brain"

seed_ro_helpers() {
for D in bin builtin; do
if [ -d "$HOME/.gemini/antigravity-cli/$D" ] && [ ! -e "$GSTATE/antigravity-cli/$D" ]; then
cp -r "$HOME/.gemini/antigravity-cli/$D" "$GSTATE/antigravity-cli/$D" 2>/dev/null || true
fi
done
}

if [ "$MODE" = "proot" ]; then
[ -d "$HOME/.gemini" ] || mkdir -p "$HOME/.gemini"
seed_ro_helpers
PA=(-b "$GSTATE:$HOME/.gemini")
PA+=(-w "$TARGET_WS")
exec proot "${PA[@]}" "$SELF_ABS" --inner
elif [ "$MODE" = "bwrap" ]; then
[ -d "$HOME/.gemini" ] || mkdir -p "$HOME/.gemini"
BA=(--dev-bind / /)
BA+=(--bind "$GSTATE" "$HOME/.gemini")
for D in bin builtin; do
if [ -d "$HOME/.gemini/antigravity-cli/$D" ]; then
mkdir -p "$GSTATE/antigravity-cli/$D"
BA+=(--ro-bind "$HOME/.gemini/antigravity-cli/$D" "$HOME/.gemini/antigravity-cli/$D")
fi
done
BA+=(--chdir "$TARGET_WS")
exec bwrap "${BA[@]}" "$SELF_ABS" --inner
else
ISO="$BRAIN_DIR/home"
mkdir -p "$ISO"
ln -sfn "$GSTATE" "$ISO/.gemini"
seed_ro_helpers
HOME="$ISO" exec "$SELF_ABS" --inner
fi
