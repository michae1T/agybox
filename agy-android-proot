#!/data/data/com.termux/files/usr/bin/bash
# Runs Google Antigravity CLI (agy) inside Fedora proot-distro on Android (Termux).
# Tracks per-session folders, last-used timestamps, workspace trust, and conversation IDs.

CMD="${1:-}"
SUB="${2:-}"
case "$CMD" in
-h|--help)
echo "agy-android-proot - Run agy CLI in Fedora proot on Android (Termux)"
echo "Usage:"
echo "  agy-android-proot                     List sessions by last used and prompt"
echo "  agy-android-proot <name|#>            Start or resume session by name or #"
echo "  agy-android-proot manage              Delete, archive, or unarchive a session"
echo "  agy-android-proot temp [new|#]        Create or resume a temp session (.tmp/)"
echo "  agy-android-proot temp manage         Promote or delete a temp session"
echo "  agy-android-proot backup              Back up chats + sessions to Google Drive"
echo "  agy-android-proot backup auth         Re-authorize Google Drive in browser"
echo "  agy-android-proot backup ignore [id]  Edit global or session .backupignore"
echo "  agy-android-proot restore             Restore chats + sessions from Google Drive"
echo "  agy-android-proot --help              Show this help message"
exit 0
;;
esac

cd || exit 1
mkdir -p sessions
cd sessions || exit 1

ensure_rclone() {
if ! command -v rclone >/dev/null 2>&1; then
echo "Installing rclone..."
pkg install -y rclone || exit 1
fi
export BROWSER=termux-open-url
}

auth_drive() {
if rclone listremotes 2>/dev/null | grep -qx 'agy-drive:'; then
echo "Reconnecting agy-drive in browser..."
rclone config reconnect agy-drive:
else
echo "Opening browser to authorize Google Drive (drive.file scope)..."
rclone config create agy-drive drive scope=drive.file
fi
}

ensure_drive() {
ensure_rclone
if ! rclone listremotes 2>/dev/null | grep -qx 'agy-drive:'; then
auth_drive || exit 1
fi
}

rclone_try() {
"$@" && return 0
read -r -p "Drive transfer failed. Re-authorize in browser? [y/N]: " REAUTH
case "$REAUTH" in
y|Y)
auth_drive || return 1
"$@"
;;
*)
return 1
;;
esac
}

init_global_ignore() {
if [ ! -f .backupignore ]; then
cat << 'IGN' > .backupignore
# Global exclusions for agy-android-proot backup (rclone --exclude-from)
/.name
/.t
/.ts
/.run-agy.sh
/.sync-agy.sh
/.agy-state/**
/.ex
.venv/**
venv/**
node_modules/**
__pycache__/**
*.pyc
.git/**
target/**
dist/**
build/**
IGN
fi
}

init_session_ignore() {
DIR="$1"
if [ ! -f "$DIR/.backupignore" ]; then
cat << 'SIGN' > "$DIR/.backupignore"
# Per-session exclusions for private Google Drive backup (rclone --exclude-from)
# Add one pattern per line (e.g. folder/**, *.bin, secret.jpg).
.venv/**
venv/**
node_modules/**
__pycache__/**
*.pyc
.git/**
target/**
dist/**
build/**
SIGN
fi
}

init_common_context() {
if [ ! -f GEMINI.md ]; then
cat << 'GMD' > GEMINI.md
# Session Backup Exclusion Policy

Each session directory has a `.backupignore` file (using `rclone --exclude-from` syntax, one pattern per line, such as `folder/**`, `*.bin`, or `secret.jpg`) that controls what is excluded when backing up to the user's private Google Drive.

Whenever you create, download, inspect, or notice files in the current session directory:
1. Keep `.backupignore` in this session directory updated to exclude anything that should NOT be uploaded to Google Drive:
   - Virtual environments, package caches, build artifacts, and dependency folders (`.venv/**`, `node_modules/**`, `__pycache__/**`, `build/**`, etc.).
   - Most binaries, archives, disk images, or large generated artifacts—unless they are small helper scripts or utilities worth keeping.
   - Anything highly sensitive if it ends up in the session directory (such as photos or scans of a passport or ID, bank details, financial documents, private keys, `.env` secrets, or credentials).
2. Use `rclone` patterns relative to the session root (for directories use `dir/**`; for single files use `filename.ext` or `subdir/filename.ext`).
3. If you are in doubt about whether a file or binary should be excluded or backed up, ask the user for confirmation before changing `.backupignore` or assuming it is safe.
GMD
fi
}

build_excludes() {
init_global_ignore
cat .backupignore > .ex
for BASE in . .tmp .archive; do
[ -d "$BASE" ] || continue
while IFS= read -r D; do
if [ "$BASE" = "." ]; then
P="$D"
else
P="$BASE/$D"
fi
[ -d "$P" ] || continue
init_session_ignore "$P"
while IFS= read -r L; do
L="${L%$'\r'}"
case "$L" in
""|\#*) continue ;;
esac
L="${L#/}"
printf '/%s/' "$P" >> .ex
echo "$L" >> .ex
printf '/%s/**/' "$P" >> .ex
echo "$L" >> .ex
done < "$P/.backupignore"
done < <(sorted_dirs "$BASE")
done
}

sorted_dirs() {
BASE="${1:-.}"
[ -d "$BASE" ] || return 0
(
cd "$BASE" || exit 0
for D in */; do
[ -d "$D" ] || continue
D="${D%/}"
TS=0
if [ -f "$D/.last" ]; then
read -r TS < "$D/.last"
else
stat -c %Y "$D" > .ts 2>/dev/null
read -r TS < .ts
rm -f .ts
fi
TS="${TS:-0}"
printf '%s ' "$TS"
echo "$D"
done | sort -rn | cut -d' ' -f2-
)
}

rand_name() {
R=$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 6)
printf 'tmp-%s\n' "$R"
}

write_sync_helper() {
cat << 'SYN' > .sync-agy.sh
#!/bin/bash
SRC=/root/.gemini/antigravity-cli
DST=/root/sessions/.agy-state
if [ "$1" = "export" ]; then
rm -rf "$DST"
mkdir -p "$DST"
for D in brain conversations knowledge; do
if [ -d "$SRC/$D" ]; then
cp -r "$SRC/$D" "$DST/$D" 2>/dev/null || true
fi
done
if [ -f "$SRC/settings.json" ]; then
cp "$SRC/settings.json" "$DST/settings.json" 2>/dev/null || true
fi
find "$DST" -name '*.lock' -delete 2>/dev/null || true
chmod -R u+rwX "$DST" 2>/dev/null || true
elif [ "$1" = "import" ]; then
mkdir -p "$SRC"
for D in brain conversations knowledge; do
if [ -d "$DST/$D" ]; then
mkdir -p "$SRC/$D"
cp -ru "$DST/$D/." "$SRC/$D/" 2>/dev/null || cp -r "$DST/$D/." "$SRC/$D/" 2>/dev/null || true
fi
done
if [ -f "$DST/settings.json" ] && [ ! -f "$SRC/settings.json" ]; then
cp "$DST/settings.json" "$SRC/settings.json" 2>/dev/null || true
fi
fi
SYN
}

if [ "$CMD" = "backup" ]; then
if [ "$SUB" = "ignore" ]; then
init_global_ignore
TARGET=".backupignore"
ARG3="${3:-}"
if [ -n "$ARG3" ]; then
if [ -d "$ARG3" ]; then
init_session_ignore "$ARG3"
TARGET="$ARG3/.backupignore"
elif [ -d ".tmp/$ARG3" ]; then
init_session_ignore ".tmp/$ARG3"
TARGET=".tmp/$ARG3/.backupignore"
else
echo "Session not found: $ARG3"
exit 1
fi
fi
ED="${EDITOR:-}"
if [ -z "$ED" ]; then
if command -v nano >/dev/null 2>&1; then
ED=nano
elif command -v vi >/dev/null 2>&1; then
ED=vi
fi
fi
if [ -n "$ED" ]; then
"$ED" "$TARGET"
else
echo "Edit $PWD/$TARGET"
cat "$TARGET"
fi
exit 0
fi
ensure_drive
if [ "$SUB" = "auth" ]; then
auth_drive || exit 1
exit 0
fi
write_sync_helper
B="$PWD:/root/sessions"
echo "Exporting Fedora chat history..."
proot-distro login fedora --bind "$B" -- /bin/bash /root/sessions/.sync-agy.sh export
if [ -d .agy-state/brain ]; then
echo "Backing up transcripts to agy-drive:agy-backup/brain..."
rclone_try rclone copy .agy-state/brain agy-drive:agy-backup/brain -v || { rm -rf .agy-state .sync-agy.sh; exit 1; }
fi
if [ -d .agy-state/conversations ]; then
echo "Backing up conversation state to agy-drive:agy-backup/conversations..."
rclone_try rclone copy .agy-state/conversations agy-drive:agy-backup/conversations -v || { rm -rf .agy-state .sync-agy.sh; exit 1; }
fi
if [ -d .agy-state/knowledge ]; then
rclone_try rclone copy .agy-state/knowledge agy-drive:agy-backup/knowledge -v || { rm -rf .agy-state .sync-agy.sh; exit 1; }
fi
if [ -f .agy-state/settings.json ]; then
rclone_try rclone copyto .agy-state/settings.json agy-drive:agy-backup/settings.json -v || { rm -rf .agy-state .sync-agy.sh; exit 1; }
fi
rm -rf .agy-state .sync-agy.sh
build_excludes
echo "/.agy-state/**" >> .ex
echo "/.sync-agy.sh" >> .ex
echo "Backing up sessions to agy-drive:agy-backup/sessions..."
EX=(--exclude-from .ex --exclude-if-present .nobackup)
rclone_try rclone copy . agy-drive:agy-backup/sessions "${EX[@]}" -v
RC=$?
rm -f .ex
[ "$RC" -eq 0 ] || exit 1
echo "Backup complete."
exit 0
fi

if [ "$CMD" = "restore" ]; then
ensure_drive
echo "Restoring sessions from agy-drive:agy-backup/sessions..."
rclone_try rclone copy agy-drive:agy-backup/sessions . -v || exit 1
rm -rf .agy-state
mkdir -p .agy-state/brain .agy-state/conversations .agy-state/knowledge
echo "Restoring transcripts and conversation state..."
rclone_try rclone copy agy-drive:agy-backup/brain .agy-state/brain -v || { rm -rf .agy-state; exit 1; }
rclone copy agy-drive:agy-backup/conversations .agy-state/conversations -v 2>/dev/null || true
rclone copy agy-drive:agy-backup/knowledge .agy-state/knowledge -v 2>/dev/null || true
rclone copyto agy-drive:agy-backup/settings.json .agy-state/settings.json -v 2>/dev/null || true
write_sync_helper
B="$PWD:/root/sessions"
proot-distro login fedora --bind "$B" -- /bin/bash /root/sessions/.sync-agy.sh import
rm -rf .agy-state .sync-agy.sh
echo "Restore complete."
exit 0
fi

if [ "$CMD" = "manage" ]; then
mkdir -p .archive
echo "1) Delete"
echo "2) Archive"
echo "3) Unarchive"
read -r -p "Choose action [1-3]: " ACT
if [ "$ACT" = "1" ]; then
ITEMS=()
PATHS=()
N=0
while IFS= read -r D; do
[ -d "$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
PATHS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .)
while IFS= read -r D; do
[ -d ".archive/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
PATHS+=(".archive/$D")
printf '%s) [archived] ' "$N"
echo "$D"
done < <(sorted_dirs .archive)
if [ "$N" -eq 0 ]; then
echo "No sessions found."
exit 0
fi
read -r -p "Delete #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
TARGET="${PATHS[IDX]}"
NAME="${ITEMS[IDX]}"
if [ -n "$TARGET" ]; then
printf 'Delete %s? [y/N]: ' "$NAME"
read -r ANS
case "$ANS" in
y|Y)
rm -rf "$TARGET"
echo "Deleted."
;;
esac
fi
fi
exit 0
elif [ "$ACT" = "2" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d "$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .)
if [ "$N" -eq 0 ]; then
echo "No active sessions."
exit 0
fi
read -r -p "Archive #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
if [ -e ".archive/$NAME" ]; then
echo "Already archived."
exit 1
fi
mv "$NAME" .archive/
echo "Archived."
fi
fi
exit 0
elif [ "$ACT" = "3" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d ".archive/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .archive)
if [ "$N" -eq 0 ]; then
echo "No archived sessions."
exit 0
fi
read -r -p "Unarchive #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
if [ -e "$NAME" ]; then
echo "Active session with same name exists."
exit 1
fi
mv ".archive/$NAME" .
date +%s > "$NAME/.last"
echo "Unarchived."
fi
fi
exit 0
else
echo "Cancelled."
exit 0
fi
fi

ISTEMP=0
case "$CMD" in
temp|-t) ISTEMP=1 ;;
esac
REL=""
if [ "$ISTEMP" -eq 1 ]; then
mkdir -p .tmp
if [ "$SUB" = "manage" ]; then
echo "1) Promote to primary"
echo "2) Delete"
read -r -p "Choose action [1-2]: " ACT
if [ "$ACT" = "1" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d ".tmp/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .tmp)
if [ "$N" -eq 0 ]; then
echo "No temp sessions."
exit 0
fi
read -r -p "Promote #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
printf 'Primary name [%s]: ' "$NAME"
read -r NEWNAME
if [ -z "$NEWNAME" ]; then
NEWNAME="$NAME"
fi
NEWNAME="${NEWNAME// /-}"
NEWNAME="${NEWNAME//\//-}"
if [ -e "$NEWNAME" ]; then
echo "Session with that name already exists."
exit 1
fi
mv ".tmp/$NAME" .tmp-mv
mv .tmp-mv "$NEWNAME"
date +%s > "$NEWNAME/.last"
echo "Promoted."
fi
fi
exit 0
elif [ "$ACT" = "2" ]; then
ITEMS=()
N=0
while IFS= read -r D; do
[ -d ".tmp/$D" ] || continue
N=$((N + 1))
ITEMS+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .tmp)
if [ "$N" -eq 0 ]; then
echo "No temp sessions."
exit 0
fi
read -r -p "Delete #: " NUM
if [ "$NUM" -gt 0 ] 2>/dev/null; then
IDX=$((NUM - 1))
NAME="${ITEMS[IDX]}"
if [ -n "$NAME" ]; then
printf 'Delete temp %s? [y/N]: ' "$NAME"
read -r ANS
case "$ANS" in
y|Y)
rm -rf ".tmp/$NAME"
echo "Deleted."
;;
esac
fi
fi
exit 0
else
echo "Cancelled."
exit 0
fi
fi

LIST=()
N=0
while IFS= read -r D; do
[ -d ".tmp/$D" ] || continue
N=$((N + 1))
LIST+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .tmp)

PICK="$SUB"
if [ -z "$PICK" ]; then
read -r -p "Temp # or name [new random]: " PICK
fi
case "$PICK" in
""|new)
SESSION=$(rand_name)
;;
*)
if [ "$PICK" -gt 0 ] 2>/dev/null; then
IDX=$((PICK - 1))
FOUND="${LIST[IDX]}"
if [ -n "$FOUND" ]; then
SESSION="$FOUND"
else
SESSION="$PICK"
fi
else
SESSION="$PICK"
fi
;;
esac
SESSION="${SESSION// /-}"
SESSION="${SESSION//\//-}"
REL=".tmp/$SESSION"
else
LIST=()
N=0
while IFS= read -r D; do
[ -d "$D" ] || continue
N=$((N + 1))
LIST+=("$D")
printf '%s) ' "$N"
echo "$D"
done < <(sorted_dirs .)

SESSION="$CMD"
if [ -z "$SESSION" ]; then
read -r -p "Session name or # [default]: " SESSION
fi
SESSION="${SESSION:-default}"
if [ "$SESSION" -gt 0 ] 2>/dev/null; then
IDX=$((SESSION - 1))
PICK="${LIST[IDX]}"
if [ -n "$PICK" ]; then
SESSION="$PICK"
fi
fi
SESSION="${SESSION// /-}"
SESSION="${SESSION//\//-}"
REL="$SESSION"
fi

mkdir -p "$REL"
init_session_ignore "$REL"
init_common_context
date +%s > "$REL/.last"
printf '%s\n' "$REL" > .name
W="/root/sessions/$REL"
echo "{\"trustedWorkspaces\":[\"$W\"]}" > .t

printf '%s\n' '#!/bin/bash
[ -f /etc/profile ] && . /etc/profile
if [ -f /root/.bash_profile ]; then
. /root/.bash_profile
fi
[ -f /root/.bashrc ] && . /root/.bashrc
export PATH="/root/.local/bin:$PATH"
mkdir -p /root/.gemini/config
if [ ! -e /root/.gemini/config/GEMINI.md ] || [ -L /root/.gemini/config/GEMINI.md ]; then
ln -sf /root/sessions/GEMINI.md /root/.gemini/config/GEMINI.md
fi
S=$(cat /root/sessions/.name)
cd "/root/sessions/$S" || exit 1
BRAIN=/root/.gemini/antigravity-cli/brain
mkdir -p "$BRAIN"
if [ -f .conv ]; then
CID=$(cat .conv)
/root/.local/bin/agy --conversation "$CID" --mode auto --settings /root/sessions/.t
else
ls -1 "$BRAIN" 2>/dev/null | sort > /tmp/b0
(
while true; do
sleep 2
ls -1 "$BRAIN" 2>/dev/null | sort > /tmp/b1
NEW=$(comm -13 /tmp/b0 /tmp/b1 | head -n 1)
if [ -n "$NEW" ]; then
printf "%s\n" "$NEW" > .conv
break
fi
done
) &
WPID=$!
/root/.local/bin/agy --mode auto --settings /root/sessions/.t
kill "$WPID" 2>/dev/null
fi
date +%s > .last' > .run-agy.sh

B="$PWD:/root/sessions"
A=(login fedora)
A+=(--bind "$B")
A+=(-- /bin/bash /root/sessions/.run-agy.sh)
exec proot-distro "${A[@]}"
